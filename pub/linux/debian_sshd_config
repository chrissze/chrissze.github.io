AllowAgentForwarding no

AllowTcpForwarding yes

AuthenticationMethods publickey

ChallengeResponseAuthentication no

LoginGraceTime 120

LogLevel VERBOSE

MaxAuthTries 3

MaxStartups 2

PasswordAuthentication no

PermitRootLogin no

PermitUserEnvironment no

Port 22

PrintLastLog no

# Debain Subsystem for ansible, rsync, scp, sshfs
# sftp-server is an executable presented on the debian system
Subsystem  sftp  /usr/lib/openssh/sftp-server
